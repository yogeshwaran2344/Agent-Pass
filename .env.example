# ==============================================================================
# AGENTPASS — Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL / SQLite fallback)
# For local dev without Postgres: sqlite:///./agentpass.db
DATABASE_URL=postgresql+psycopg://agentpass:agentpass_secret@localhost:5432/agentpass
POSTGRES_USER=agentpass
POSTGRES_PASSWORD=agentpass_secret
POSTGRES_DB=agentpass

# Redis & Celery Cache / Broker
REDIS_URL=redis://localhost:6379/0

# Security & JWT Tokens
SECRET_KEY=agentpass_super_secret_cryptographic_key_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PayPal Sandbox REST API Gateway
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# LLM Intent Extraction & Semantic Alignment (Optional; fallback built-in)
OPENAI_API_KEY=your_openai_or_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
